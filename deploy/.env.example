# Copy to deploy/.env and fill in. No real values here.

# File ownership for every container (same ids so files are shared). Find yours with `id`.
PUID=1000
PGID=1000

# Host paths for the mounts.
CONFIG_DIR=./config
DOWNLOADS_DIR=/path/to/downloads
DATA_DIR=/path/to/data
# Old library, mounted read-only into mixsync during migration only.
IMPORT_SOURCE_DIR=/path/to/old-library
DROP_DIR=/path/to/drop

# Database URL. Default is SQLite under /config.
MIXSYNC_DATABASE_URL=sqlite:////config/mixsync.db
# Time zone for the migration report dates (IANA name).
MIXSYNC_TIMEZONE=UTC
# Fernet key for linked-account secrets. Optional: if unset, /config/secret.key is used or generated.
MIXSYNC_SECRET_KEY=
# Contact for the MusicBrainz User-Agent. Optional.
MIXSYNC_MB_CONTACT=
# Optional local MusicBrainz mirror base URL.
MIXSYNC_MB_BASE_URL=
# AcoustID application key.
MIXSYNC_ACOUSTID_APP_KEY=
# AcoustID user key, for submitting fingerprints after a promotion (optional).
MIXSYNC_ACOUSTID_USER_KEY=
# slskd connection.
MIXSYNC_SLSKD_URL=http://slskd:5030
MIXSYNC_SLSKD_API_KEY=
# Navidrome base URL and an admin account (library rescans need admin).
MIXSYNC_NAVIDROME_URL=http://navidrome:4533
MIXSYNC_NAVIDROME_USER=
MIXSYNC_NAVIDROME_PASSWORD=
# The main library's name in Navidrome.
# MIXSYNC_NAVIDROME_LIBRARY=Music Library
# The library over /data/discover.
# MIXSYNC_NAVIDROME_DISCOVER_LIBRARY=discover

# Container paths MIXSYNC_CONFIG_DIR, MIXSYNC_DATA_DIR, MIXSYNC_DOWNLOADS_DIR and
# MIXSYNC_IMPORT_SOURCE_DIR are set by compose from the host paths above; leave them alone.

# MusicBrainz requests per second (0 to 1; MusicBrainz allows 1 req/s per IP).
# MIXSYNC_MB_RATE=1.0
# On-demand Deezer lookups mark unverified offers.
# MIXSYNC_DEEZER_SUGGESTIONS=false
# Discogs lookups via a user token mark unverified offers.
# MIXSYNC_DISCOGS_SUGGESTIONS=false
# Downloads running at once (1 or more).
# MIXSYNC_MAX_CONCURRENT_DOWNLOADS=3
# Seconds the average download rate is taken over.
# MIXSYNC_SLOW_DOWNLOAD_WINDOW=60
# Bytes/s: below this a transfer is slow.
# MIXSYNC_SLOW_DOWNLOAD_FLOOR=50000
# Share (0 to 1) of total download throughput below which a transfer is slow.
# MIXSYNC_SLOW_DOWNLOAD_SHARE=0.10
# Backup folder (SQLite only). Unset: /config/backups.
# MIXSYNC_BACKUP_DIR=
# Drop folder inside the container (compose mounts DROP_DIR there); read-write, originals go to the trash. Unset: no drop folder.
# MIXSYNC_DROP_DIR=/drop
# Import album folders nobody requested that land in downloads.
# MIXSYNC_ADOPT_DOWNLOADS=false
# Minutes a folder must be quiet before it is adopted (1 or more).
# MIXSYNC_ADOPT_SETTLE_MINUTES=10
# FLAC compression level, 0 to 8 (above 8 leaves the FLAC subset).
# MIXSYNC_FLAC_LEVEL=8
# Preferred release formats, best first (JSON list).
# MIXSYNC_CANONICAL_MEDIA=["Digital Media", "CD"]
# Preferred release countries, best first (JSON list).
# MIXSYNC_CANONICAL_COUNTRIES=["XW"]
# Trash from day folders older than this many days is purged (1 or more).
# MIXSYNC_TRASH_DAYS=30
# Library path layout. Changing it does not move existing files (reorganize: see #285).
# MIXSYNC_PATH_TEMPLATE={albumartist}/{album} ({year})/{disc:02}-{track:02} {title}.{ext}

# Behind a TLS reverse proxy: the proxy container's fixed IP, so the session cookie gets
# Secure and the login limit sees real client IPs. Stop publishing 8080 first; a subnet or
# "*" is only safe when 8080 is reachable solely through the proxy. IPs/CIDRs, not hostnames.
# FORWARDED_ALLOW_IPS=<proxy ip>
