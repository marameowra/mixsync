# Copy to deploy/.env and fill in. No real values here.

# File ownership for every container (same ids so files are shared). Find yours with `id`.
PUID=1000
PGID=1000

# Host paths for the mounts.
CONFIG_DIR=./config
DOWNLOADS_DIR=/path/to/downloads
DATA_DIR=/path/to/data
# Old library, mounted read-only into mixsync during migration only.
IMPORT_SOURCE_DIR=/path/to/old-library

# Database URL. Default is SQLite under /config.
MIXSYNC_DATABASE_URL=sqlite:////config/mixsync.db
# Fernet key for linked-account secrets. Optional: if unset, /config/secret.key is used or generated.
MIXSYNC_SECRET_KEY=
# Contact for the MusicBrainz User-Agent. Optional.
MIXSYNC_MB_CONTACT=
# Optional local MusicBrainz mirror base URL.
MIXSYNC_MB_BASE_URL=
# AcoustID application key.
MIXSYNC_ACOUSTID_APP_KEY=
# slskd connection.
MIXSYNC_SLSKD_URL=http://slskd:5030
MIXSYNC_SLSKD_API_KEY=
# Navidrome base URL (users link their own credentials).
MIXSYNC_NAVIDROME_URL=http://navidrome:4533
